# Copy this file to .env. Generate a key with: openssl rand -hex 32
SESSION_ENCRYPTION_KEY=
IDENTITY_URL=https://8examples.com
PUBLISHERS_FILE=./config.local.json
DB_FILE=./data/glasses.sqlite
HOST=127.0.0.1
PORT=8795

# Optional until the iPhone app is signed for push. Never commit the .p8 key.
APNS_KEY_FILE=
APNS_TEAM_ID=
APNS_KEY_ID=
APNS_TOPIC=ai-assistant.8examples.com
# Match the app entitlement: debug=sandbox, TestFlight/release=production.
APNS_ENVIRONMENT=sandbox
