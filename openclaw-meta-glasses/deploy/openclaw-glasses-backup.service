[Unit]
Description=Back up the OpenClaw glasses relay database and private configuration
After=docker.service

[Service]
Type=oneshot
User=root
UMask=0077
ExecStart=/usr/bin/python3 /home/openclaw/managed-openclaw/openclaw-meta-glasses/deploy/backup.py
TimeoutStartSec=300
Nice=10
PrivateTmp=true
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/home/openclaw/openclaw-backups/meta-glasses /home/openclaw/managed-openclaw/openclaw-meta-glasses/data
