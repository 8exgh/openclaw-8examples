# The CQRS backend is 8examples.com (src/app/api/mobile/*)
BACKEND_API_URL=https://8examples.com
# A fleet telemetry access token (oct_…) — minted in the 8examples admin
# Fleet tab, or the deploy-time TELEMETRY_ACCESS_TOKEN. Same tokens the
# telemetry reporter uses; nothing new to distribute.
BACKEND_ACCESS_TOKEN=oct_changeme

POLLING_INTERVAL_MS=3000

# How owner messages reach a claw:
#   docker  — `docker exec openclaw-<clawId> openclaw agent …` (same as rocketchat/bridge.mjs);
#             run this on the box that hosts the openclaw-* containers
#   echo    — reply with the message text (local development, no containers)
CLAW_RUNNER=docker
CONTAINER_PREFIX=openclaw-
AGENT_TIMEOUT_MS=150000
